---
import LanguagePicker from './LanguagePicker.astro';
import ThemeToggle from './ThemeToggle.astro';
import { getLangFromUrl, useTranslations } from '../i18n/translate';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<header class="sticky top-0 z-50 bg-white/80 dark:bg-background-dark/80 backdrop-blur-md border-b border-primary/10">
    <div class="flex items-center justify-between px-4 h-16 max-w-2xl mx-auto w-full">
        <div class="flex items-center gap-2">
            <div class="bg-primary rounded-lg p-1.5 flex items-center justify-center">
                <span class="material-symbols-outlined text-white text-[20px]">terminal</span>
            </div>
            <h1 class="text-lg font-extrabold tracking-tight">JS.<span class="text-primary">DEV</span></h1>
        </div>
        <div class="flex items-center gap-3">
            <ThemeToggle />
            <LanguagePicker />
            <a href={`mailto:${t('header.email')}`} class="bg-primary text-white hover:bg-primary/90 transition-colors px-4 py-2 rounded-lg text-sm font-bold shadow-sm shadow-primary/20">
                {t('header.contact')}
            </a>
        </div>
    </div>
</header>
