---
import { getLangFromUrl, useTranslations } from '../i18n/translate';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<section id="about" class="flex flex-col items-center text-center mb-12">
    <div class="relative mb-6">
        <div class="absolute inset-0 bg-primary/20 rounded-full blur-2xl -z-10 animate-pulse"></div>
        <img
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuBLdfHQD6kI5xx5QxKWsjpT3vqTuyHU1pzjLY_eJ_cwxQUz3xZj3t8CAW2M7yhg0ZqRM8I7cJm64NyuNlUJVCsShnl8RJ4W6BjiXd5pMgpsda8QKE3a1F_bKZajRZfSi08_c6OcKg9-mvhi8ad_9dzZ0N1L0V15FVdeWIr4_ca-HxYcDPOKj7et_4gAgG359oRbyBF6bCnHEfZ97528yODjFa4DA8UM7YCll8M31_TGyEcI61OuSgQlUSeahciwzqpk1KqGhWtSod4"
            alt={t('hero.image_alt')}
            class="w-32 h-32 rounded-full border-4 border-white dark:border-slate-800 shadow-xl object-cover"
        />
    </div>
    <h2 class="text-3xl font-extrabold mb-3 tracking-tight">
        {t('hero.greeting')}<span class="text-primary">{t('hero.name')}</span>
    </h2>
    <p class="text-slate-600 dark:text-slate-400 text-lg mb-6 leading-relaxed max-w-md">
        {t('hero.description_prefix')}<span class="font-bold text-slate-900 dark:text-white">{t('hero.description_highlight')}</span>{t('hero.description_suffix')}
    </p>

    <div class="flex gap-3">
        <a href={t('hero.socials.code')} class="w-12 h-12 flex items-center justify-center rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 shadow-sm hover:border-primary transition-all">
            <span class="material-symbols-outlined">code</span>
        </a>
        <a href={t('hero.socials.share')} class="w-12 h-12 flex items-center justify-center rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 shadow-sm hover:border-primary transition-all">
            <span class="material-symbols-outlined">share</span>
        </a>
        <a href={t('hero.socials.email')} class="w-12 h-12 flex items-center justify-center rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 shadow-sm hover:border-primary transition-all">
            <span class="material-symbols-outlined">alternate_email</span>
        </a>
    </div>
</section>
