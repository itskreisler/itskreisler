---
import Layout from "@/layouts/Layout.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/translate";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const otherLang = lang === "es" ? "en" : "es";
const otherLangPath = otherLang === "es" ? "" : `/${otherLang}`;
const currentLangPath = lang === "es" ? "" : `/${lang}`;
---

<Layout>
	<nav
		class="fixed top-0 left-0 right-0 z-50 bg-[var(--bg-primary)]/80 backdrop-blur-sm border-b border-[var(--border-color)]"
	>
		<div
			class="max-w-[1920px] mx-auto px-6 py-4 flex items-center justify-between"
		>
			<a
				href={currentLangPath}
				class="font-[400] text-[20px] tracking-[-0.14px] text-[var(--text-primary)]"
			>
				KREISLER
			</a>
			<div class="flex items-center gap-6">
				<div class="hidden md:flex items-center gap-6">
					<a
						href="#about"
						class="font-[400] text-[16px] tracking-[-0.14px] text-[var(--text-primary)] link-underline"
						>{t("nav.about")}</a
					>
					<a
						href="#skills"
						class="font-[400] text-[16px] tracking-[-0.14px] text-[var(--text-primary)] link-underline"
						>{t("nav.skills")}</a
					>
					<a
						href="#projects"
						class="font-[400] text-[16px] tracking-[-0.14px] text-[var(--text-primary)] link-underline"
						>{t("nav.projects")}</a
					>
					<a href="#contact" class="btn-pill btn-pill-black"
						>{t("nav.contact")}</a
					>
				</div>
				<div class="flex items-center gap-3">
					<div class="lang-switch">
						<button
							id="lang-es"
							class={lang === "es" ? "active" : ""}
							aria-label="Español">ES</button
						>
						<button
							id="lang-en"
							class={lang === "en" ? "active" : ""}
							aria-label="English">EN</button
						>
					</div>
					<button
						id="theme-toggle"
						class="btn-icon"
						aria-label="Toggle theme"
					>
						<svg
							id="theme-icon-sun"
							class="theme-icon-sun"
							width="20"
							height="20"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
						>
							<circle cx="12" cy="12" r="5"></circle><path
								d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"
							></path>
						</svg>
						<svg
							id="theme-icon-moon"
							class="theme-icon-moon"
							width="20"
							height="20"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
						>
							<path
								d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
							></path>
						</svg>
					</button>
				</div>
			</div>
		</div>
	</nav>

	<main>
		<section
			class="gradient-hero min-h-screen flex items-center justify-center relative overflow-hidden"
		>
			<div
				class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-[var(--bg-primary)]"
			>
			</div>
			<div class="relative z-10 text-center max-w-[1200px] px-6">
				<p class="font-mono-label mb-6 text-[#ffffff]">
					{t("hero.label")}
				</p>
				<h1 class="font-display text-[#ffffff] mb-6">
					{t("hero.title")}
				</h1>
				<p
					class="font-subheading-light text-[#ffffff]/90 max-w-[800px] mx-auto mb-10"
				>
					{t("hero.subtitle")}
				</p>
				<div class="flex gap-4 justify-center">
					<a href="#projects" class="btn-pill btn-pill-white"
						>{t("hero.cta_projects")}</a
					>
					<a
						href="#contact"
						class="btn-circle btn-circle-glass-light"
					>
						<svg
							width="20"
							height="20"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
						>
							<path d="M12 5v14M5 12h14"></path>
						</svg>
					</a>
				</div>
			</div>
			<div
				class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce"
			>
				<svg
					width="24"
					height="24"
					viewBox="0 0 24 24"
					fill="none"
					stroke="#ffffff"
					stroke-width="2"
				>
					<path d="M12 5v14M5 12l7 7 7-7"></path>
				</svg>
			</div>
		</section>

		<section id="about" class="py-24 px-6 bg-[var(--bg-primary)]">
			<div class="max-w-[1200px] mx-auto">
				<p class="font-mono-label mb-8 text-[var(--text-primary)]">
					{t("about.label")}
				</p>
				<h2 class="font-section text-[var(--text-primary)] mb-8">
					{t("about.title")}
				</h2>
				<div class="grid md:grid-cols-2 gap-12">
					<div>
						<p
							class="font-body-large text-[var(--text-primary)]/80 mb-6"
						>
							{t("about.description")}
						</p>
						<p class="font-body text-[var(--text-primary)]/70">
							{t("about.description2")}
						</p>
					</div>
					<div class="flex flex-col gap-6">
						<div
							class="p-6 border border-[var(--border-color)] rounded-[8px] bg-[var(--bg-secondary)]"
						>
							<h3
								class="font-subheading text-[var(--text-primary)] mb-2"
							>
								{t("about.frontend")}
							</h3>
							<p class="font-body text-[var(--text-primary)]/70">
								{t("about.frontend_tech")}
							</p>
						</div>
						<div
							class="p-6 border border-[var(--border-color)] rounded-[8px] bg-[var(--bg-secondary)]"
						>
							<h3
								class="font-subheading text-[var(--text-primary)] mb-2"
							>
								{t("about.backend")}
							</h3>
							<p class="font-body text-[var(--text-primary)]/70">
								{t("about.backend_tech")}
							</p>
						</div>
						<div
							class="p-6 border border-[var(--border-color)] rounded-[8px] bg-[var(--bg-secondary)]"
						>
							<h3
								class="font-subheading text-[var(--text-primary)] mb-2"
							>
								{t("about.mobile")}
							</h3>
							<p class="font-body text-[var(--text-primary)]/70">
								{t("about.mobile_tech")}
							</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section id="skills" class="py-24 px-6 bg-[var(--bg-secondary)]">
			<div class="max-w-[1200px] mx-auto">
				<p class="font-mono-label mb-8 text-[var(--text-primary)]">
					{t("skills.label")}
				</p>
				<h2 class="font-section text-[var(--text-primary)] mb-12">
					{t("skills.title")}
				</h2>
				<div
					class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4"
				>
					{
						[
							"React",
							"Astro",
							"TypeScript",
							"Node.js",
							"Python",
							"PHP",
							"MySQL",
							"Android",
							"TailwindCSS",
							"Git",
							"Figma",
							"Docker",
						].map((skill) => (
							<div class="p-4 bg-[var(--bg-primary)] border border-[var(--border-color)] rounded-[8px] text-center hover:border-[var(--text-primary)]/30 transition-colors">
								<p class="font-body text-[var(--text-primary)]">
									{skill}
								</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<section id="projects" class="py-24 px-6 bg-[var(--bg-primary)]">
			<div class="max-w-[1200px] mx-auto">
				<p class="font-mono-label mb-8 text-[var(--text-primary)]">
					{t("projects.label")}
				</p>
				<h2 class="font-section text-[var(--text-primary)] mb-12">
					{t("projects.title")}
				</h2>
				<div class="grid md:grid-cols-2 gap-8">
					<a
						href="https://github.com/itskreisler/telegram-bot"
						target="_blank"
						rel="noopener"
						class="group cursor-pointer block"
					>
						<div
							class="aspect-video bg-gradient-to-br from-[#00d4aa] to-[#9b59f6] rounded-[8px] mb-4 overflow-hidden"
						>
							<div
								class="w-full h-full flex items-center justify-center"
							>
								<svg
									class="w-16 h-16 text-white/50"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.5"
								>
									<path
										d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"
									></path>
								</svg>
							</div>
						</div>
						<h3
							class="font-subheading text-[var(--text-primary)] mb-2"
						>
							{t("projects.telegram_bot")}
						</h3>
						<p class="font-body text-[var(--text-primary)]/70 mb-4">
							{t("projects.telegram_bot_desc")}
						</p>
						<div class="flex gap-2">
							<span
								class="text-[12px] px-2 py-1 bg-[var(--text-primary)]/5 rounded-[2px] text-[var(--text-primary)]/60"
								>Node.js</span
							>
							<span
								class="text-[12px] px-2 py-1 bg-[var(--text-primary)]/5 rounded-[2px] text-[var(--text-primary)]/60"
								>Telegram API</span
							>
						</div>
					</a>
					<a
						href="https://github.com/itskreisler/js-google-translate-free"
						target="_blank"
						rel="noopener"
						class="group cursor-pointer block"
					>
						<div
							class="aspect-video bg-gradient-to-br from-[#ffdd00] to-[#ff4d8d] rounded-[8px] mb-4 overflow-hidden"
						>
							<div
								class="w-full h-full flex items-center justify-center"
							>
								<svg
									class="w-16 h-16 text-white/50"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.5"
								>
									<path
										d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"
									></path>
								</svg>
							</div>
						</div>
						<h3
							class="font-subheading text-[var(--text-primary)] mb-2"
						>
							{t("projects.translate_api")}
						</h3>
						<p class="font-body text-[var(--text-primary)]/70 mb-4">
							{t("projects.translate_api_desc")}
						</p>
						<div class="flex gap-2">
							<span
								class="text-[12px] px-2 py-1 bg-[var(--text-primary)]/5 rounded-[2px] text-[var(--text-primary)]/60"
								>JavaScript</span
							>
							<span
								class="text-[12px] px-2 py-1 bg-[var(--text-primary)]/5 rounded-[2px] text-[var(--text-primary)]/60"
								>API</span
							>
						</div>
					</a>
				</div>
			</div>
		</section>

		<section id="contact" class="py-24 px-6 bg-[var(--bg-secondary)]">
			<div class="max-w-[800px] mx-auto text-center">
				<p class="font-mono-label mb-8 text-[var(--text-primary)]">
					{t("contact.label")}
				</p>
				<h2 class="font-section text-[var(--text-primary)] mb-6">
					{t("contact.title")}
				</h2>
				<p class="font-body-large text-[var(--text-primary)]/70 mb-10">
					{t("contact.description")}
				</p>
				<div class="flex gap-4 justify-center">
					<a
						href="https://github.com/itskreisler"
						target="_blank"
						rel="noopener"
						class="btn-circle btn-circle-glass-dark"
					>
						<svg
							width="20"
							height="20"
							viewBox="0 0 24 24"
							fill="currentColor"
						>
							<path
								d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
							></path>
						</svg>
					</a>
					<a
						href="https://twitter.com/itskreisler"
						target="_blank"
						rel="noopener"
						class="btn-circle btn-circle-glass-dark"
					>
						<svg
							width="20"
							height="20"
							viewBox="0 0 24 24"
							fill="currentColor"
						>
							<path
								d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
							></path>
						</svg>
					</a>
					<a
						href="https://linkedin.com/in/kreisler"
						target="_blank"
						rel="noopener"
						class="btn-circle btn-circle-glass-dark"
					>
						<svg
							width="20"
							height="20"
							viewBox="0 0 24 24"
							fill="currentColor"
						>
							<path
								d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
							></path>
						</svg>
					</a>
					<a
						href="mailto:kreisler@example.com"
						class="btn-pill btn-pill-black">{t("contact.email")}</a
					>
				</div>
			</div>
		</section>
	</main>

	<footer class="py-8 px-6 bg-[var(--text-primary)]">
		<div
			class="max-w-[1200px] mx-auto flex flex-col md:flex-row items-center justify-between gap-4"
		>
			<p class="font-body text-[var(--bg-primary)]/60">
				{t("footer.copyright", { year: new Date().getFullYear() })}
			</p>
			<div class="flex gap-6">
				<a
					href="https://github.com/itskreisler"
					target="_blank"
					rel="noopener"
					class="font-[400] text-[14px] tracking-[-0.1px] text-[var(--bg-primary)]/60 link-underline"
					>GitHub</a
				>
				<a
					href="https://twitter.com/itskreisler"
					target="_blank"
					rel="noopener"
					class="font-[400] text-[14px] tracking-[-0.1px] text-[var(--bg-primary)]/60 link-underline"
					>Twitter</a
				>
				<a
					href="https://linkedin.com/in/kreisler"
					target="_blank"
					rel="noopener"
					class="font-[400] text-[14px] tracking-[-0.1px] text-[var(--bg-primary)]/60 link-underline"
					>LinkedIn</a
				>
			</div>
		</div>
	</footer>
</Layout>

<script is:inline>
	const getPreferredTheme = () => {
		const saved = localStorage.getItem("theme");
		if (saved) return saved;
		return window.matchMedia("(prefers-color-scheme: dark)").matches
			? "dark"
			: "light";
	};

	const theme = getPreferredTheme();
	document.documentElement.setAttribute("data-theme", theme);

	document
		.getElementById("theme-toggle")
		.addEventListener("click", function () {
			const currentTheme =
				document.documentElement.getAttribute("data-theme");
			const newTheme = currentTheme === "dark" ? "light" : "dark";
			document.documentElement.setAttribute("data-theme", newTheme);
			localStorage.setItem("theme", newTheme);
		});

	document.getElementById("lang-es").addEventListener("click", function () {
		const currentPath = window.location.pathname;
		if (currentPath.includes("/en/")) {
			window.location.href = currentPath.replace("/en/", "/");
		} else if (currentPath === "/en") {
			window.location.href = "/";
		}
	});

	document.getElementById("lang-en").addEventListener("click", function () {
		const currentPath = window.location.pathname;
		if (
			currentPath === "/" ||
			currentPath === "" ||
			currentPath === "/es" ||
			currentPath === "/es/"
		) {
			window.location.href = "/en/";
		}
	});
</script>

<style>
	section {
		scroll-margin-top: 80px;
	}

	.theme-icon-sun {
		display: none;
		color: #ffd700;
	}

	.theme-icon-moon {
		display: inline;
		color: #fff;
	}

	:global([data-theme="light"]) .theme-icon-sun {
		display: inline;
	}

	:global([data-theme="light"]) .theme-icon-moon {
		display: none;
	}

	@media (max-width: 768px) {
		nav :global(.hidden) {
			display: none;
		}
	}
</style>
