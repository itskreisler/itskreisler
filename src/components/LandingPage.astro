---
import "@/styles/global.css";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import TechStack from "./TechStack.astro";
import Projects from "./Projects.astro";
import Footer from "./Footer.astro";
import BottomNav from "./BottomNav.astro";
---

<div class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1 w-full max-w-2xl mx-auto px-4 py-8">
        <Hero />
        <TechStack />
        <div id="projects">
            <Projects />
        </div>
    </main>
    <Footer />
    <BottomNav />
</div>

<style>
    @reference "@/styles/global.css";

    /* Ensure the body or main container takes full height if needed */
    :global(body) {
        @apply bg-[#f6f7f8] dark:bg-[#101922];
    }
</style>
