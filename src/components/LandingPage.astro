---
import "@/styles/global.css";
import { t18n } from "@/i18n/translate";
const t = t18n(Astro.url);
const copyright = t("footer.copyright", {
    year: new Date().getFullYear(),
    author: "Kreisler",
});
---

<body>
    <header class="py-6 text-center bg-gray-100 dark:bg-gray-800">
        <h1 class="text-2xl font-bold text-gray-800 dark:text-gray-100">
            Portafolio
        </h1>
    </header>
    <main>
        <section class="flex flex-col items-center justify-center gap-4">
            <svg
                class="w-16 h-16 text-yellow-400 animate-bounce"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 6v6l4 2"></path>
                <circle
                    cx="12"
                    cy="12"
                    r="10"
                    stroke="currentColor"
                    stroke-width="1.5"
                    fill="none"></circle>
            </svg>
            <h2 class="text-xl font-semibold text-gray-700 dark:text-gray-200">
                ¡Portafolio en construcción!
            </h2>
            <p class="text-gray-500 dark:text-gray-400">
                Vuelve pronto para ver las novedades.
            </p>
        </section>
    </main>
    <footer
        set:html={copyright}
        class="py-4 text-center text-xs text-gray-400 bg-gray-50 dark:bg-gray-900"
    />
</body>

<style>
    @reference "@/styles/global.css";
    body {
        @apply grid min-h-dvh grid-rows-[auto_1fr_auto];
    }
    main {
        @apply flex items-center justify-center;
    }
</style>
