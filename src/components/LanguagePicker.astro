---
import { getLangFromUrl } from "@/i18n/translate";

const lang = getLangFromUrl(Astro.url);
const targetLang = lang === 'es' ? 'en' : 'es';
const label = lang === 'es' ? 'EN' : 'ES';
---

<a
    href={`/${targetLang}/`}
    class="flex items-center gap-1.5 px-3 py-2 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-primary/10 hover:text-primary transition-colors text-xs font-bold uppercase tracking-wider"
>
    <span class="material-symbols-outlined text-[18px]">language</span>
    <span>{label}</span>
</a>
