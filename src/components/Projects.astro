---
import { getLangFromUrl, useTranslations } from '../i18n/translate';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const projects = t('projects.items') as {
    id: string;
    title: string;
    description: string;
    code_url: string;
    demo_url: string;
    image: string;
}[];
---
<section class="mb-12">
    <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-primary">folder_open</span>
            <h3 class="text-xl font-bold">{t('projects.title')}</h3>
        </div>
        <span class="text-xs font-bold uppercase tracking-widest text-slate-400">{t('projects.subtitle')}</span>
    </div>

    <div class="space-y-6">
        {projects.map((project) => (
            <div class="bg-white dark:bg-slate-800 rounded-xl overflow-hidden shadow-sm border border-slate-200 dark:border-slate-700 group">
                <div class="relative aspect-video overflow-hidden">
                    <img
                        src={project.image}
                        alt={project.title}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    />
                    <div class="absolute top-3 right-3 bg-slate-900/80 backdrop-blur px-2 py-1 rounded text-[10px] text-white font-bold uppercase tracking-tighter">
                        {t('projects.badge')} #{project.id}
                    </div>
                </div>
                <div class="p-5">
                    <h4 class="text-lg font-bold mb-2 group-hover:text-primary transition-colors">{project.title}</h4>
                    <p class="text-slate-600 dark:text-slate-400 text-sm mb-5 leading-relaxed">
                        {project.description}
                    </p>
                    <div class="grid grid-cols-2 gap-3">
                        <a href={project.code_url} class="flex items-center justify-center gap-2 py-2.5 bg-slate-900 dark:bg-slate-700 text-white rounded-lg text-sm font-bold hover:bg-slate-800 transition-colors">
                            <span class="material-symbols-outlined text-sm">terminal</span> {t('projects.code')}
                        </a>
                        <a href={project.demo_url} class="flex items-center justify-center gap-2 py-2.5 bg-primary text-white rounded-lg text-sm font-bold shadow-lg shadow-primary/20 hover:bg-primary/90 transition-colors">
                            <span class="material-symbols-outlined text-sm">visibility</span> {t('projects.demo')}
                        </a>
                    </div>
                </div>
            </div>
        ))}
    </div>
</section>
